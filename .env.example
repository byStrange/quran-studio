# ---------------------------------------------------------------------------
# Quran Studio — environment configuration
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Supabase (frontend-safe) ----------------------------------------------
# The publishable key is designed to ship in a client bundle; all access is
# constrained by Row Level Security.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Supabase (server-side only) -------------------------------------------
# Used ONLY by the seed/import scripts in scripts/seed. Bypasses RLS.
# Never prefix this with VITE_ — that would inline it into the frontend bundle.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Ollama Cloud (server-side only) ---------------------------------------
# Read by the Rust Tauri backend. Never exposed to the webview.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
# Optional: pin a model. If unset, the backend picks gemma4:31b-cloud when the
# account's /api/tags catalog offers it, and falls back to the catalog order.
OLLAMA_MODEL=gemma4:31b-cloud
